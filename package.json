{
  "name": "pi-as-mcp",
  "version": "0.1.0",
  "description": "Expose pi core coding tools as MCP over stdio or Streamable HTTP, with optional persistent Herdr-backed coding agents.",
  "type": "module",
  "bin": {
    "pi-mcp": "./src/index.ts"
  },
  "files": [
    "src/",
    "LICENSE",
    "scripts/setup.sh",
    "scripts/service.sh",
    "server/.env.example"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "setup": "./scripts/setup.sh",
    "start": "./scripts/service.sh start",
    "stop": "./scripts/service.sh stop",
    "restart": "./scripts/service.sh restart",
    "status": "./scripts/service.sh status",
    "logs": "./scripts/service.sh logs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-server": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6"
  },
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaikozlov/pi-as-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kaikozlov/pi-as-mcp/issues"
  },
  "homepage": "https://github.com/kaikozlov/pi-as-mcp#readme",
  "keywords": [
    "mcp",
    "pi",
    "coding-agent",
    "model-context-protocol"
  ],
  "license": "MIT"
}
