{
  "name": "pi-as-mcp",
  "version": "0.1.0",
  "description": "Expose pi's core coding tools (read, write, edit, bash) as an MCP server over stdio.",
  "type": "module",
  "bin": {
    "pi-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "scripts/tunnel-install.sh",
    "scripts/tunnel.sh",
    "tunnel/.env.example",
    "tunnel/profile.yaml"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run clean && tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "smoke": "node scripts/smoke.mjs",
    "smoke:cancel": "node scripts/cancel.mjs",
    "test": "npm run typecheck && npm run build && npm run smoke && npm run smoke:cancel",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaikozlov/pi-as-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kaikozlov/pi-as-mcp/issues"
  },
  "homepage": "https://github.com/kaikozlov/pi-as-mcp#readme",
  "keywords": [
    "mcp",
    "pi",
    "coding-agent",
    "model-context-protocol"
  ],
  "license": "MIT"
}
