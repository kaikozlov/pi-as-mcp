{
  "name": "pi-as-mcp",
  "version": "0.1.0",
  "description": "Expose pi core coding tools as MCP over stdio or Streamable HTTP, with optional persistent Herdr-backed coding agents.",
  "type": "module",
  "bin": {
    "pi-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "scripts/setup.sh",
    "scripts/tunnel-install.sh",
    "scripts/tunnel-runtime.mjs",
    "scripts/tunnel.sh",
    "tunnel/.env.example",
    "tunnel/profile.yaml",
    "scripts/http.sh",
    "server/.env.example",
    "scripts/cloudflare.sh",
    "scripts/setup-http.sh"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "node dist/index.js",
    "setup": "./scripts/setup.sh",
    "tunnel": "./scripts/tunnel.sh run",
    "tunnel:start": "./scripts/tunnel.sh start",
    "tunnel:attach": "./scripts/tunnel.sh attach",
    "tunnel:session": "./scripts/tunnel.sh session",
    "tunnel:stop": "./scripts/tunnel.sh stop",
    "tunnel:info": "./scripts/tunnel.sh info",
    "tunnel:foreground": "./scripts/tunnel.sh foreground",
    "tunnel:doctor": "./scripts/tunnel.sh doctor",
    "tunnel:status": "./scripts/tunnel.sh status",
    "tunnel:ui": "./scripts/tunnel.sh ui",
    "build": "bun run clean && tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "smoke": "node scripts/smoke.mjs",
    "smoke:cancel": "node scripts/cancel.mjs",
    "smoke:sync-cap": "node scripts/smoke-sync-cap.mjs",
    "smoke:herdr": "node scripts/smoke-herdr.mjs",
    "smoke:tunnel-runtime": "node scripts/smoke-tunnel-runtime.mjs",
    "test:shell": "bash -n scripts/*.sh",
    "test": "bun run typecheck && bun run test:shell && bun run build && bun run smoke && bun run smoke:cancel && bun run smoke:sync-cap && bun run smoke:herdr && bun run smoke:http && bun run smoke:http-auth && bun run smoke:tunnel-runtime",
    "prepack": "bun run build",
    "http": "./scripts/http.sh run",
    "http:status": "./scripts/http.sh status",
    "smoke:http": "node scripts/http-smoke.mjs",
    "smoke:http-auth": "node scripts/http-auth-smoke.mjs",
    "http:start": "./scripts/http.sh start",
    "http:stop": "./scripts/http.sh stop",
    "http:logs": "./scripts/http.sh logs",
    "cloudflare": "./scripts/cloudflare.sh run",
    "cloudflare:start": "./scripts/cloudflare.sh start",
    "cloudflare:stop": "./scripts/cloudflare.sh stop",
    "cloudflare:status": "./scripts/cloudflare.sh status",
    "cloudflare:logs": "./scripts/cloudflare.sh logs",
    "setup:http": "./scripts/setup-http.sh"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-server": "^0.85.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "@types/express": "^5.0.6"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaikozlov/pi-as-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kaikozlov/pi-as-mcp/issues"
  },
  "homepage": "https://github.com/kaikozlov/pi-as-mcp#readme",
  "keywords": [
    "mcp",
    "pi",
    "coding-agent",
    "model-context-protocol"
  ],
  "license": "MIT"
}
