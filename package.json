{
  "name": "pi-as-mcp",
  "version": "0.1.0",
  "description": "Expose pi's core coding tools (read, write, edit, bash) as an MCP server over stdio or Streamable HTTP.",
  "type": "module",
  "bin": {
    "pi-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "scripts/setup.sh",
    "scripts/http.sh",
    "server/.env.example"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "node dist/index.js",
    "setup": "./scripts/setup.sh",
    "http": "./scripts/http.sh run",
    "http:status": "./scripts/http.sh status",
    "build": "bun run clean && tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "smoke": "node scripts/smoke.mjs",
    "smoke:cancel": "node scripts/cancel.mjs",
    "smoke:http": "node scripts/http-smoke.mjs",
    "smoke:http-auth": "node scripts/http-auth-smoke.mjs",
    "test:shell": "bash -n scripts/*.sh",
    "test": "bun run typecheck && bun run test:shell && bun run build && bun run smoke && bun run smoke:cancel && bun run smoke:http && bun run smoke:http-auth",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaikozlov/pi-as-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kaikozlov/pi-as-mcp/issues"
  },
  "homepage": "https://github.com/kaikozlov/pi-as-mcp#readme",
  "keywords": [
    "mcp",
    "pi",
    "coding-agent",
    "model-context-protocol"
  ],
  "license": "MIT"
}
