# Local settings for scripts/tunnel.sh. Copy with:
#   install -m 600 tunnel/.env.example tunnel/.env
# then edit tunnel/.env (it is gitignored).

# Base directory for pi's tools. This is path resolution, NOT a sandbox.
# For a persistent development workbench, a broad root such as ~/dev is useful.
PI_MCP_CWD=./sandbox

# Optional tool subset. Without Herdr configured, omitting this exposes pi's
# four defaults. With PI_MCP_HERDR_SESSION set, omission also enables the
# persistent subagent tool group; `agent` is the configuration-group alias.
# PI_MCP_TOOLS=read,bash

# Return long bash calls before the tunnel command-response deadline. Commands
# still running after this window continue as durable, pollable bash sessions.
PI_MCP_BASH_MAX_SYNC_SECONDS=20

# Optional retained-agent workspace limit. 0 means unlimited.
# PI_MCP_MAX_AGENTS=0

# Optional persistent project runtime. When set, this dedicated named Herdr
# session owns both the tunnel's reserved `runtime` terminal and the additional
# persistent subagent workspaces. Never use `default`: the isolation boundary is
# intentional.
# PI_MCP_HERDR_SESSION=pi-as-mcp
# PI_MCP_HERDR_BIN=herdr

# OpenAI Secure MCP Tunnel credentials.
# tunnel: https://platform.openai.com/settings/organization/tunnels
# key:    https://platform.openai.com/settings/organization/api-keys
CONTROL_PLANE_TUNNEL_ID=tunnel_paste_your_tunnel_id_here
CONTROL_PLANE_API_KEY=sk_paste_your_runtime_key_here
