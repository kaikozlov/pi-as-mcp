# Copy to tunnel/.env (gitignored) and fill in.
#
# tunnel id:  https://platform.openai.com/settings/organization/tunnels
# api key:    https://platform.openai.com/settings/organization/api-keys
#             (use a runtime key, NOT an admin key)
CONTROL_PLANE_TUNNEL_ID=tunnel_paste_your_tunnel_id_here
CONTROL_PLANE_API_KEY=sk_paste_your_runtime_key_here
