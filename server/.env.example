# Direct Streamable HTTP deployment (typically behind Cloudflare Access).
PI_MCP_CWD="$HOME/dev"
PI_MCP_TOOLS="read,write,edit,bash,agent"
PI_MCP_BASH_MAX_SYNC_SECONDS="20"
# Optional retained-agent workspace limit. 0 means unlimited.
# PI_MCP_MAX_AGENTS="0"
# Optional backend override; omp is preferred automatically when installed.
# PI_MCP_DEFAULT_AGENT="pi"
PI_MCP_HERDR_SESSION="pi-as-mcp"
PI_MCP_TRANSPORT="http"
PI_MCP_HTTP_HOST="127.0.0.1"
PI_MCP_HTTP_PORT="3333"
PI_MCP_HTTP_PATH="/mcp"
PI_MCP_HTTP_ALLOWED_HOSTS="mcp.example.com"
PI_MCP_AUTH="cloudflare-access"
PI_MCP_LOG_FILE="./logs/http-lifecycle.jsonl"

# Cloudflare Zero Trust Access application values (not OAuth client secrets).
CF_ACCESS_TEAM_DOMAIN="https://your-team.cloudflareaccess.com"
CF_ACCESS_AUD="paste-access-application-audience-tag"
