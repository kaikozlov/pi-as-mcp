# pi-as-mcp Streamable HTTP server configuration.
# Copy to server/.env (bun run setup does this automatically).

PI_MCP_CWD="$HOME/dev"
# PI_MCP_TOOLS="read,write,edit,bash"
PI_MCP_TRANSPORT="http"
PI_MCP_HTTP_HOST="127.0.0.1"
PI_MCP_HTTP_PORT="3333"
PI_MCP_HTTP_PATH="/mcp"
PI_MCP_HTTP_ALLOWED_HOSTS="mcp.example.com"

# Secure-by-default HTTP auth. For localhost-only testing, temporarily set none.
PI_MCP_AUTH="cloudflare-access"

# Cloudflare Zero Trust Access values for the MCP application.
# Team domain example: https://your-team.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN="https://your-team.cloudflareaccess.com"
CF_ACCESS_AUD="paste-access-application-audience-tag"
